---
interface Props {
  title: string
  description: string
  href: string
}

const { title, description, href } = Astro.props
---

<a class="notebook-card" href={href}>
  <h2>{title}</h2>
  <p>{description}</p>
  <span>Open notebook →</span>
</a>

<style>
  .notebook-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 0.75rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .notebook-card:hover {
    transform: translateY(-4px);
    border-color: currentColor;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
  }

  p {
    margin: 0 0 1rem;
    opacity: 0.8;
    line-height: 1.6;
    flex-grow: 1;
  }

  span {
    font-weight: 600;
  }
</style>