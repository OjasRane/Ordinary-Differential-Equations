---
interface Props {
  title: string
  description: string
  src: string
  type?: 'gif' | 'video'
}

const {
  title,
  description,
  src,
  type = 'gif',
} = Astro.props
---

<div class="animation-card">
  <div class="media">
    {
      type === 'video' ? (
        <video controls muted loop playsinline>
          <source src={src} type="video/mp4" />
        </video>
      ) : (
        <img src={src} alt={title} loading="lazy" />
      )
    }

    <button class="focus-button" aria-label={`Focus ${title}`}>
      ⛶
    </button>
  </div>

  <div class="content">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  <dialog class="lightbox">
    <button class="close-button" aria-label="Close">×</button>

    <div class="focused-media">
      {
        type === 'video' ? (
          <video controls autoplay muted loop playsinline>
            <source src={src} type="video/mp4" />
          </video>
        ) : (
          <img src={src} alt={title} />
        )
      }
    </div>

    <h2>{title}</h2>
  </dialog>
</div>

<script>
  function setupLightboxes() {
    document.querySelectorAll('.animation-card').forEach((card) => {
      const dialog = card.querySelector('.lightbox')
      const openButton = card.querySelector('.focus-button')
      const closeButton = card.querySelector('.close-button')

      if (
        !(dialog instanceof HTMLDialogElement) ||
        !(openButton instanceof HTMLButtonElement) ||
        !(closeButton instanceof HTMLButtonElement)
      ) {
        return
      }

      openButton.onclick = () => {
        dialog.showModal()
      }

      closeButton.onclick = () => {
        dialog.close()
      }

      dialog.onclick = (event) => {
        if (event.target === dialog) {
          dialog.close()
        }
      }
    })
  }

  setupLightboxes()
  document.addEventListener('astro:page-load', setupLightboxes)
</script>

<style>
  .animation-card {
    overflow: hidden;
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 0.75rem;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: rgba(128, 128, 128, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .media img,
  .media video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .focus-button {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;

    width: 2.5rem;
    height: 2.5rem;

    border: none;
    border-radius: 0.5rem;

    background: rgba(0, 0, 0, 0.7);
    color: white;

    font-size: 1.25rem;
    cursor: pointer;
  }

  .focus-button:hover {
    background: rgba(0, 0, 0, 0.9);
  }

  .content {
    padding: 1.25rem;
  }

  .content h2 {
    margin: 0 0 0.6rem;
    font-size: 1.2rem;
  }

  .content p {
    margin: 0;
    line-height: 1.6;
    opacity: 0.8;
  }

  .lightbox {
    width: min(95vw, 1200px);
    max-width: none;
    padding: 1.5rem;

    border: 1px solid rgba(128, 128, 128, 0.4);
    border-radius: 0.75rem;

    background: #111;
    color: white;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
  }

  .focused-media {
    display: flex;
    align-items: center;
    justify-content: center;

    max-height: 80vh;
  }

  .focused-media img,
  .focused-media video {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  .close-button {
    position: absolute;
    right: 1rem;
    top: 0.75rem;

    border: none;
    background: rgba(0, 0, 0, 0.7);
    color: white;

    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;

    font-size: 1.6rem;
    cursor: pointer;

    z-index: 10;
  }

  .lightbox h2 {
    margin: 1rem 0 0;
    text-align: center;
  }
</style>